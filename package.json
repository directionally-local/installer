{
  "name": "directionallylocal",
  "version": "0.9.1",
  "description": "Directionally Local: background coding agents on your own server. One-line server install, and the dl command for your server and laptop.",
  "license": "Apache-2.0",
  "homepage": "https://directionallylocal.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/directionally-local/installer.git"
  },
  "bugs": {
    "url": "https://github.com/directionally-local/installer/issues"
  },
  "type": "module",
  "bin": {
    "directionallylocal": "bin/directionallylocal.mjs",
    "dl": "bin/directionallylocal.mjs"
  },
  "files": [
    "bin",
    "dist",
    "install.sh",
    "README.md"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p site/tsconfig.json && tsc -p services/tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"site/**/*.test.ts\" \"services/**/*.test.ts\"",
    "sync:site-script": "node site/generate-install-script.mjs",
    "check:portable": "node scripts/check-portable-apis.mjs services/name services/shared",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "autopilot-ai": "3.0.4"
  }
}
