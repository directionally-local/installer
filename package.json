{
  "name": "directionallylocal",
  "version": "0.1.1",
  "description": "One-line server install for Directionally Local: Hotcell sandboxes and Autopilot, ready for autopilot --on",
  "type": "module",
  "bin": {
    "directionallylocal": "bin/directionallylocal.mjs",
    "dl": "bin/directionallylocal.mjs"
  },
  "files": [
    "bin",
    "dist",
    "install.sh",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p site/tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"site/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
