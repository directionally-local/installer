# Copy to .dev.vars for `wrangler dev -c services/free/wrangler.jsonc`. Never commit .dev.vars.
OPENROUTER_API_KEY=sk-or-...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
# At least 32 bytes, e.g. `openssl rand -base64 48`.
TOKEN_SIGNING_KEY=...
# Comma-separated numeric GitHub ids (not logins): `gh api users/<login> --jq .id`.
ADMIN_GITHUB_IDS=...
# Optional alerts. Email needs the send_email binding (wrangler.cloudflare.jsonc) and a verified address.
# ALERT_EMAIL_TO=owner@example.com
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
