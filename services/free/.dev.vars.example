# Copy to .dev.vars for `wrangler dev -c services/free/wrangler.jsonc`. Never commit .dev.vars.
OPENROUTER_API_KEY=sk-or-...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
# At least 32 bytes, e.g. `openssl rand -base64 48`.
TOKEN_SIGNING_KEY=...
# Comma-separated numeric GitHub ids (not logins): `gh api users/<login> --jq .id`.
ADMIN_GITHUB_IDS=...
# Optional alerts. Email needs the send_email binding (wrangler.cloudflare.jsonc) and a verified address.
# ALERT_EMAIL_TO=owner@example.com
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional: new feedback, unsupported-agent requests and provider inquiries also go to Slack.
# SLACK_FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional paid plans (test mode). See README "Stripe setup".
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# (Pro is priced inline from PRO_PRICE_USD_MONTHLY: no STRIPE_PRICE_PRO needed)
# STRIPE_PRICE_TOPUP=price_...
