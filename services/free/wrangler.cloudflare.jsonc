{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "directionallylocal-free",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "WEEKLY_TOKENS": "50000000",
    "MAX_ACTIVE_USERS": "50",
    "GLOBAL_WEEKLY_USD_CAP": "250",
    "GLOBAL_TOTAL_USD_CAP": "1000",
    "PER_PERSON_WEEKLY_USD_CAP": "5",
    "MIN_GITHUB_ACCOUNT_AGE_DAYS": "30",
    "OPEN_ADMISSION": "false",
    "REQUIRE_GITHUB_ACTIVITY": "true",
    "COUNT_CACHED_TOKENS": "true",
    "OPENROUTER_PROVIDER_ORDER": "",
    "OPENROUTER_QUANTIZATIONS": "fp8,mxfp8,fp16,bf16,fp32",
    "OPENROUTER_DATA_COLLECTION": "deny",
    "OPENROUTER_HOST_COOLDOWN_MINUTES": "10",
    "PAUSED": "false",
    "QUEUE_THRESHOLD": "0.8",
    "QUEUE_REFERRAL_PLACES": "25",
    "REFERRAL_BONUS_TOKENS": "10000000",
    "REFERRAL_BONUS_CAP": "50000000",
    "ALERT_EMAIL_FROM": "alerts@dl.new"
  },
  "send_email": [{ "name": "ALERT_EMAIL" }],
  "durable_objects": {
    "bindings": [
      { "name": "AUTH", "class_name": "AuthObject" },
      { "name": "DIRECTORY", "class_name": "DirectoryObject" },
      { "name": "ACCOUNT", "class_name": "AccountObject" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthObject", "DirectoryObject", "AccountObject", "RateLimiterObject"]
    }
  ],
  "routes": [{ "pattern": "free.directionallylocal.com", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
